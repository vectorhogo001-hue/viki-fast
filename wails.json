{
  "name": "viki-fast",
  "outputfilename": "viki-fast",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "Viki Fast Team",
    "email": "team@viki-fast.org"
  },
  "info": {
    "companyName": "Viki Fast",
    "productName": "Viki Fast",
    "productVersion": "0.1.0",
    "copyright": "Copyright © 2024 Viki Fast Team. All rights reserved."
  },
  "windows": {
    "webviewInstallMode": {
      "mode": "download",
      "silent": true
    },
    "webviewUserDataPath": "",
    "windowIsTranslucent": false,
    "disableWindowIcon": false,
    "disableFramelessWindowDecorations": false,
    "webviewBrowserPath": "",
    "disablePinchZoom": true
  },
  "mac": {
    "bundleIdentifier": "org.vikifast.gui",
    "appCategory": "public.app-category.utilities",
    "minimumSystemVersion": "11.0",
    "disableUniversalBinary": false
  },
  "linux": {
    "appCategory": "Network",
    "desktopFileCategories": "Network;Utility;",
    "programName": "viki-fast",
    "iconPath": "build/linux/icon.png"
  },
  "updater": {
    "enabled": true,
    "githubOwner": "viki-fast",
    "githubRepository": "viki-fast"
  }
}